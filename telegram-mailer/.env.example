# ======================
# Telegram Mailer Config
# ======================

# Bot Configuration
BOT_TOKEN=your_bot_token_here
# Admin IDs - comma separated list of Telegram user IDs
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Database (PostgreSQL)
POSTGRES_USER=mailer
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=telegram_mailer
DATABASE_URL=postgresql+asyncpg://mailer:secure_password_here@postgres:5432/telegram_mailer
DATABASE_ECHO=false

# Redis
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://:redis_secure_password@redis:6379/0

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key_here

# Telegram API (for Telethon workers)
# Get from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# File Storage Paths
SESSIONS_PATH=/app/data/sessions
MEDIA_PATH=/app/data/media

# User Limits
MAX_ACCOUNTS_PER_USER=50
MAX_PROXIES_PER_USER=50
MAX_FOLDERS_PER_USER=100
MAX_CAMPAIGNS_PER_USER=50

# Default Campaign Settings
DEFAULT_WORK_HOURS=4
DEFAULT_REST_MINUTES=30
DEFAULT_INTERVAL_MIN=25
DEFAULT_INTERVAL_MAX=45

# 16/8 Cycle Configuration
DEFAULT_USER_WINDOW_START=08:00
USER_WINDOW_HOURS=16
ADMIN_WINDOW_HOURS=8

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Worker Configuration
WORKER_HEALTH_CHECK_INTERVAL=300
WORKER_STATS_FLUSH_INTERVAL=60
